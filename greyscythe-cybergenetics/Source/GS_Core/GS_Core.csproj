<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0">

  <PropertyGroup>
    <BaseIntermediateOutputPath>\tmp\obj\1.6\</BaseIntermediateOutputPath>
    <MSBUildProjectExtensionsPath>\tmp\obj\1.6\</MSBUildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <AssemblyName>GS_Core</AssemblyName>
    <DefineConstants>v1_6</DefineConstants>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <ProjectGuid>{2939CD5F-F598-4D85-9FB2-D2EFC3CA94BF}</ProjectGuid>

    <!-- Reproducible builds: no timestamps/random GUIDs, normalized source
         paths. ContinuousIntegrationBuild is deliberately NOT set: it makes
         the SDK embed the git HEAD SHA into the assembly, so every commit
         would change the DLL bytes and the committed artifact could never
         match a fresh build. Disable source-control metadata for the same
         reason. -->
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned exact versions; floating ranges resolve differently over time. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
